<configuration>

    <appender name="STDOUT"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>

            <pattern>
                [%X{transactionId}]
                %-5level
                %msg%n
            </pattern>

        </encoder>

    </appender>

    <root level="INFO">

        <appender-ref ref="STDOUT"/>

    </root>

</configuration>